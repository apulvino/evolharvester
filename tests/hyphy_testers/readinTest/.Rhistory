print(rbind(
r_const("gene", gene_exp), r_const("json_file", file_exp),
data.frame(column="partition", json=paste(sort(as.integer(names(J$MLE$content))),collapse=","),
csv=paste(sort(unique(csv$partition)),collapse=","), match=all(csv$partition %in% as.integer(names(J$MLE$content)))),
data.frame(column="partition_codon_range", json=paste(sort(unique(vapply(RR,function(r) rng(r$p),""))),collapse=","),
csv=paste(sort(unique(csv$partition_codon_range)),collapse=","), match=all(vapply(seq_len(n),function(i) csv$partition_codon_range[i]==rng(RR[[i]]$p),logical(1)))),
data.frame(column="branch", json=sprintf("%d valid",n), csv=sprintf("%d branches",length(unique(csv$branch))),
match=all(vapply(seq_len(n),function(i) RR[[i]]$b %in% names(J[["branch attributes"]][[RR[[i]]$p]]) || RR[[i]]$b %in% subbr(RR[[i]]$p),logical(1)))),
r_srow("Global_MG94xREV","gmg","num"), r_srow("Nucleotide_GTR","ng","num"), r_srow("original_name","on","str"),
r_list("site_positions","pos","int"), r_list("site_pval","pv","num"), r_list("site_LRT","lr","num"),
r_list("site_alpha","al","num"), r_list("site_beta_plus","be","num"), r_list("site_MEMElogl","lg","num"),
r_list("site_substitution","sb","str")
), row.names = FALSE)
View(J)
View(csv)
View(J)
View(csv)
J   <- fromJSON("FMO1_FUBAR.json", simplifyVector = FALSE)
csv <- read.csv("fmo1_fubarEH.csv", stringsAsFactors = FALSE, check.names = FALSE)
tol <- 1e-8; n <- nrow(csv); jf <- "FMO1_FUBAR.json"
## header-anchored resolution (would catch a FEL-style drift in the harvester's hardcoded [0-5])
hdr <- vapply(J$MLE$headers, function(h) h[[1]], character(1))
ia<-match("alpha",hdr); ib<-match("beta",hdr); iba<-match("beta-alpha",hdr)
ipg<-match("Prob[alpha>beta]",hdr); ipl<-match("Prob[alpha<beta]",hdr); ibf<-match("BayesFactor[alpha<beta]",hdr)
gene_exp <- sub("_.*","", basename(J[["input"]][["file name"]]))                          # JSON's own input slot
info <- J$analysis$info; prog_exp <- gsub("[()]","", regmatches(info, regexpr("\\([A-Za-z-]+\\)", info)))  # acronym from analysis.info
parts <- names(J$MLE$content); ba <- J[["branch attributes"]]
rng <- function(p){ cov<-as.integer(unlist(J[["data partitions"]][[p]]$coverage)); sprintf("%d-%d",min(cov),max(cov)) }
## per-partition FUBAR harvest (site-level, identical across branches): sig site = P[a>b]>=0.9 OR P[a<b]>=0.9
sig  <- function(p){ M<-J$MLE$content[[p]]; keep<-integer(0)
for (i in 0:(length(M)-1)){ r<-M[[i+1]]; pg<-r[[ipg]]; pl<-r[[ipl]]; if ((is.numeric(pg)&&pg>=0.9)||(is.numeric(pl)&&pl>=0.9)) keep<-c(keep,i) }; keep }
hcol <- function(p,s,idx) if(length(s)) vapply(s,function(i) as.numeric(J$MLE$content[[p]][[i+1]][[idx]]),numeric(1)) else numeric(0)
H <- lapply(parts, function(p){ s<-sig(p); list(sites=s+1, al=hcol(p,s,ia), be=hcol(p,s,ib), ba=hcol(p,s,iba),
pg=hcol(p,s,ipg), pl=hcol(p,s,ipl), bf=hcol(p,s,ibf)) }); names(H)<-parts
neq <- function(a,b) length(a)==length(b) && all(abs(a-b) <= tol*pmax(1,abs(b)))
pof <- function(i) as.character(csv$partition[i])
pc  <- function(x,k) if(k=="int") as.integer(fromJSON(x)) else as.numeric(fromJSON(x))
bg  <- function(v,k){ v<-v[!is.na(v)]; if(!length(v)) return("n0")
if(k=="int") sprintf("n%d[%d-%d]",length(v),min(v),max(v)) else sprintf("n%d[%s..%s]",length(v),formatC(min(v),format="g",digits=3),formatC(max(v),format="g",digits=3)) }
## builders -> column | json | csv | match, each checked over ALL rows
r_const<- function(col,val) data.frame(column=col, json=as.character(val), csv=as.character(csv[[col]][1]), match=all(csv[[col]]==val))
r_pc   <- function(col,key,kind){ eq<-if(kind=="int") function(a,b) identical(as.integer(a),as.integer(b)) else neq   # per-partition site column
cellp<-function(p) pc(csv[[col]][csv$partition==as.integer(p)][1],kind)
data.frame(column=col, json=paste(vapply(parts,function(p) bg(H[[p]][[key]],kind),""),collapse=", "),
csv=paste(vapply(parts,function(p) bg(cellp(p),kind),""),collapse=", "),
match=all(vapply(seq_len(n),function(i) eq(pc(csv[[col]][i],kind),H[[pof(i)]][[key]]),logical(1)))) }
branch_ok <- vapply(seq_len(n),function(i){ p<-pof(i); b<-csv$branch[i]
b %in% names(ba[[p]]) && b==(if(!is.null(ba[[p]][[b]][["original name"]])) ba[[p]][[b]][["original name"]] else b) },logical(1))
gtrref <- vapply(seq_len(n),function(i){ g<-ba[[pof(i)]][[csv$branch[i]]][["Nucleotide GTR"]]; if(is.null(g)) NA_real_ else g },numeric(1))
print(rbind(
r_const("gene", gene_exp), r_const("program", prog_exp),
data.frame(column="partition", json=paste(sort(as.integer(parts)),collapse=","), csv=paste(sort(unique(csv$partition)),collapse=","), match=all(csv$partition %in% as.integer(parts))),
data.frame(column="partition_codon_range", json=paste(vapply(parts,rng,""),collapse=", "), csv=paste(sort(unique(csv$partition_codon_range)),collapse=", "), match=all(vapply(seq_len(n),function(i) csv$partition_codon_range[i]==rng(pof(i)),logical(1)))),
data.frame(column="branch", json=sprintf("%d rows",n), csv=sprintf("%d valid/%d uniq",sum(branch_ok),length(unique(csv$branch))), match=all(branch_ok)),
data.frame(column="GTR", json=bg(gtrref,"num"), csv=bg(csv$GTR,"num"), match=all(vapply(seq_len(n),function(i){g<-ba[[pof(i)]][[csv$branch[i]]][["Nucleotide GTR"]]; !is.null(g)&&abs(as.numeric(csv$GTR[i])-g)<=tol*max(1,abs(g))},logical(1)))),
r_pc("sites","sites","int"), r_pc("alpha","al","num"), r_pc("beta","be","num"), r_pc("beta-alpha","ba","num"),
r_pc("Prob[alpha>beta]","pg","num"), r_pc("Prob[alpha<beta]","pl","num"), r_pc("BayesFactor[alpha<beta]","bf","num")
), row.names = FALSE)
View(csv)
View(csv)
View(csv)
csv <- read.csv("fmo1_absrelp1EH.csv")
View(csv)
jf  <- "FMO1part1_aBSREL.json"
J   <- fromJSON(jf, simplifyVector = FALSE)
csv <- read.csv("fmo1_absrelp1EH.csv", stringsAsFactors = FALSE)
tol <- 1e-8; n <- nrow(csv)
gene_exp <- sub("_aBSREL\\.json$","", basename(jf))                 # filename carve-out (no clean JSON-body source)
prog_exp <- sub("\\s.*","", J$analysis$info)                        # first token of analysis.info -> "aBSREL"
ba <- J[["branch attributes"]][["0"]]                               # single partition key within this split file
species <- function(bid){ p<-strsplit(bid,"_")[[1]]; if (length(p)>1) p[2] else "NA" }
maxo <- function(bs){ rd<-bs[["Rate Distributions"]]; if(!length(rd)) return(NA_real_); max(vapply(rd,function(x) as.numeric(x[[1]]),numeric(1))) }
## branches that SHOULD be kept: has LRT, p<=0.05, max omega class > 1 (episodic diversifying selection)
kept <- Filter(function(bid){ bs<-ba[[bid]]; pc<-bs[["Corrected P-value"]]; pu<-bs[["Uncorrected P-value"]]; pv<-if(!is.null(pc)) pc else pu; mo<-maxo(bs)
!is.null(bs[["LRT"]]) && !is.null(pv) && pv<=0.05 && !is.na(mo) && mo>1 }, names(ba))
## per selected-branch references
RR <- lapply(seq_len(n), function(i){ bid<-csv$branch_id[i]; bs<-ba[[bid]]
rd<-bs[["Rate Distributions"]]; oms<-vapply(rd,function(x) as.numeric(x[[1]]),numeric(1)); wts<-vapply(rd,function(x) as.numeric(x[[2]]),numeric(1))
dN<-bs[["Full adaptive model (non-synonymous subs/site)"]]; dS<-bs[["Full adaptive model (synonymous subs/site)"]]; pc<-bs[["Corrected P-value"]]; pu<-bs[["Uncorrected P-value"]]
list(bid=bid, LRT=bs[["LRT"]], pv=if(!is.null(pc)) pc else pu, pc=pc, pu=pu, dN=dN, dS=dS,
bo=if(!is.null(dN)&&!is.null(dS)&&dS!=0) dN/dS else NULL, bom=bs[["Baseline MG94xREV omega ratio"]],
blnl=bs[["Baseline MG94xREV"]], gtr=bs[["Nucleotide GTR"]], rc=bs[["Rate classes"]],
oms=oms, wts=wts, po=oms[oms>1], pw=wts[oms>1], mo=if(length(oms)) max(oms) else NA_real_) })
neq <- function(a,b) length(a)==length(b) && all(abs(a-b) <= tol*pmax(1,abs(b)))
sc  <- function(cv,ref){ if(is.null(ref)) return(is.na(cv)||cv==""); !is.na(cv) && abs(as.numeric(cv)-as.numeric(ref))<=tol*max(1,abs(as.numeric(ref))) }
pl  <- function(x){ v<-fromJSON(x); if(length(v)==0) numeric(0) else as.numeric(v) }
bg  <- function(v,k){ v<-v[!is.na(v)]; if(!length(v)) return("n0"); if(k=="str") return(paste(sort(unique(v)),collapse=",")); sprintf("n%d[%s..%s]",length(v),formatC(min(v),format="g",digits=3),formatC(max(v),format="g",digits=3)) }
## builders -> column | json | csv | match, each checked over ALL rows
r_const<- function(col,val) data.frame(column=col, json=as.character(val), csv=as.character(csv[[col]][1]), match=all(csv[[col]]==val))
r_sb   <- function(col,key){ bag<-vapply(RR,function(r){x<-r[[key]]; if(is.null(x)) NA_real_ else as.numeric(x)},numeric(1))       # per-branch scalar
data.frame(column=col, json=bg(bag,"num"), csv=bg(csv[[col]],"num"), match=all(vapply(seq_len(n),function(i) sc(csv[[col]][i],RR[[i]][[key]]),logical(1)))) }
r_lb   <- function(col,key) data.frame(column=col, json=bg(unlist(lapply(RR,`[[`,key)),"num"),                                     # per-branch rate-class list
csv=bg(unlist(lapply(seq_len(n),function(i) pl(csv[[col]][i]))),"num"),
match=all(vapply(seq_len(n),function(i) neq(pl(csv[[col]][i]),RR[[i]][[key]]),logical(1))))
print(rbind(
r_const("gene_id", gene_exp), r_const("program", prog_exp),
data.frame(column="branch_id", json=sprintf("%d selected",length(kept)), csv=sprintf("%d rows",n), match=setequal(csv$branch_id, kept)),
data.frame(column="species", json=bg(vapply(RR,function(r) species(r$bid),""),"str"),
csv=paste(sort(unique(ifelse(is.na(csv$species),"NA",csv$species))),collapse=","),
match=all(vapply(seq_len(n),function(i){ e<-species(csv$branch_id[i]); if(e=="NA") is.na(csv$species[i])||csv$species[i]=="NA" else !is.na(csv$species[i])&&csv$species[i]==e },logical(1)))),
r_sb("aBSREL_LRT","LRT"), r_sb("aBSREL_pvalue","pv"), r_sb("aBSREL_pvalue_corrected","pc"), r_sb("aBSREL_pvalue_uncorrected","pu"),
r_sb("aBSREL_branch_dN","dN"), r_sb("aBSREL_branch_dS","dS"), r_sb("aBSREL_branch_omega","bo"),
r_sb("aBSREL_baseline_omega","bom"), r_sb("aBSREL_baseline_lnL","blnl"), r_sb("aBSREL_nucleotide_GTR","gtr"),
r_sb("aBSREL_rate_classes","rc"), r_lb("aBSREL_omega_classes","oms"), r_lb("aBSREL_omega_weights","wts"),
r_lb("aBSREL_positive_omega_classes","po"), r_lb("aBSREL_positive_omega_weights","pw"), r_sb("aBSREL_max_omega","mo")
), row.names = FALSE)
# jf<- "FMO1_BUSTED.json"
# J <- fromJSON(jf, simplifyVector = FALSE)
# csv <- read.csv("fmo1_bustedEH.csv", stringsAsFactors = FALSE)
jf<- "TSPO_BUSTED.json"
J <- fromJSON(jf, simplifyVector = FALSE)
csv <- read.csv("tspo_bustedEH.csv", stringsAsFactors = FALSE)
##json slots as ground truth
U <- J$fits[["Unconstrained model"]][["Rate Distributions"]][["Test"]]
Cm <- J$fits[["Constrained model"]][["Rate Distributions"]][["Test"]]
Uom <- sapply(U, `[[`, "omega")
Upr <- sapply(U, `[[`, "proportion")
Com <- sapply(Cm, `[[`, "omega")
Cpr <- sapply(Cm, `[[`, "proportion")
lrt <- J[["test results"]][["LRT"]]
pval <- J[["test results"]][["p-value"]]
pj <- as.integer(names(J[["data partitions"]]))
##gene token from JSON's own input path
gene_exp <- sub("_.*", "", basename(J[["input"]][["file name"]]))
##float rounding unsafe for exact equality on long decimals
tol <- 1e-8
##8 gene lvl numeric cols
num <- list(lrt = lrt, pval = pval,
omega_purifying = Uom[[1]], omega_neutral = Uom[[2]], omega_positive = Uom[[3]],
proportion_purifying = Upr[[1]], proportion_neutral = Upr[[2]], proportion_positive = Upr[[3]]
)
##fits_*,parse embedded json in every row, match omega and prop vectors to the json model
fits_ok <- function(col, om, pr) {
all(vapply(csv[[col]], function(s) {
P <- fromJSON(s)
isTRUE(all(abs(P$omega - om) < tol)) && isTRUE(all(abs(P$proportion - pr) < tol))},
logical(1))
)
}
##branches, every row's set v json tested branches at that partition
branch_ok <- all(vapply(seq_len(nrow(csv)),
function(i) {
p  <- as.character(csv$partition[i])
tb <- unlist(J$tested[[p]])
setequal(fromJSON(csv$branches[i]), names(tb)[tb == "test"])
},
logical(1))
)
##codon range,every rows range v json coverage min-max at that partition
range_ok <- all(vapply(seq_len(nrow(csv)),
function(i) {
p <- as.character(csv$partition[i])
cov <- as.integer(unlist(J[["data partitions"]][[p]][["coverage"]]))
identical(sprintf("%d-%d", min(cov), max(cov)), csv$partition_codon_range[i])
}, logical(1))
)
##per-partition display values
tb_ct <- vapply(names(J[["data partitions"]]),
function(p){
tb<-unlist(J$tested[[p]])
sum(tb=="test")
}, integer(1)
)
cov_rng <- vapply(names(J[["data partitions"]]),
function(p){
cv<-as.integer(unlist(J[["data partitions"]][[p]][["coverage"]]))
sprintf("%d-%d",min(cv),max(cv))
}, character(1)
)
##one does-it-match row per busted col (14), csv value v json
cols <- c("gene", names(num), "fits_constrained_test", "fits_unconstrained_test",
"branches", "partition", "partition_codon_range")
json_v <- c(gene_exp, as.character(unlist(num)),
paste0("w=", toString(round(Com, 4))), paste0("w=", toString(round(Uom, 4))),
paste0(paste(tb_ct, collapse = ", "), " tested"),
toString(pj), toString(cov_rng))
csv_v <- c(csv$gene[1], vapply(names(num), function(k) as.character(csv[[k]][1]), character(1)),
paste0("w=", toString(round(fromJSON(csv$fits_constrained_test[1])$omega, 4))),
paste0("w=", toString(round(fromJSON(csv$fits_unconstrained_test[1])$omega, 4))),
paste0(paste(vapply(seq_len(nrow(csv)), function(i) length(fromJSON(csv$branches[i])),
integer(1)), collapse = ", "), " tested"),
toString(csv$partition), toString(csv$partition_codon_range))
match_v<- c(all(csv$gene == gene_exp),
vapply(names(num), function(k) all(abs(num[[k]] - csv[[k]]) < tol), logical(1)),
fits_ok("fits_constrained_test", Com, Cpr),
fits_ok("fits_unconstrained_test", Uom, Upr),
branch_ok,
setequal(csv$partition, pj) && length(csv$partition) == length(pj),
range_ok)
print(data.frame(column = cols, json = json_v, csv = csv_v, match = match_v),
row.names = FALSE)
##clear on 14 busted-eh cols
View(csv)
# jf <- "FMO1_GARD.json"
# J <- fromJSON(jf, simplifyVector = FALSE)
# csv <- read.csv("fmo1_gardEH.csv", stringsAsFactors = FALSE)
jf <- "TSPO_GARD.json"
J <- fromJSON(jf, simplifyVector = FALSE)
csv <- read.csv("tspo_gardEH.csv", stringsAsFactors = FALSE)
##gene token from JSON's own input path
gene_exp <- sub("_.*", "", basename(J[["input"]][["file name"]]))
###source json's own filename
file_exp <- basename(jf)
tol <- 1e-8
###Json ref vals
jnum <- c(
number_of_sequences  = J$input[["number of sequences"]],
number_of_sites      = J$input[["number of sites"]],
baselineScore        = J[["baselineScore"]],
bestModelAICc        = J[["bestModelAICc"]],
singleTreeAICc       = J[["singleTreeAICc"]],
potentialBreakpoints = J[["potentialBreakpoints"]]
)
bps <- as.numeric(unlist(list(J$breakpointData[["0"]]$bps, J$breakpointData[["1"]]$bps)))
ibp <- as.numeric(unlist(J$improvements[["0"]]$breakpoints))
dA <- as.numeric(J$improvements[["0"]]$deltaAICc)
sbps <- J$siteBreakPointSupport
jp <- as.integer(names(sbps))
nwk <- J$trees[["0"]]$newickString
tips <- regmatches(nwk, gregexpr("[^(),:;]+(?=:)", nwk, perl = TRUE))[[1]]
tips <- tips[grepl(paste0("^", gene_exp, "_"), tips)]
parts <- names(J$breakpointData)
json_rng <- vapply(parts, function(p){ bp<-as.integer(unlist(J$breakpointData[[p]]$bps)); sprintf("%d-%d",min(bp),max(bp)) }, character(1))
ord <- match(as.integer(parts), csv$partition)
##match rows, parse an compare
m_num <- vapply(names(jnum),
function(k)
all(abs(jnum[[k]] - csv[[k]]) < tol),
logical(1)
)
m_bps <- all(vapply(csv$partition_bps,
function(s)
identical(bps, as.numeric(unlist(fromJSON(s, simplifyVector = FALSE)))),
logical(1))
)
m_ibp <- all(vapply(csv$improvements_breakpoints,
function(s)
identical(ibp, as.numeric(unlist(fromJSON(s, simplifyVector = FALSE)))),
logical(1))
)
m_dA <- all(vapply(csv$improvements_deltaAICc,
function(s)
all(abs(dA - fromJSON(s)) < tol),
logical(1))
)
m_spos <- all(vapply(csv$site_positions,
function(s){
p<-fromJSON(s)
all(as.character(p) %in% names(sbps)) && length(p)==length(sbps)
}, logical(1))
)
m_ssup <- all(vapply(seq_len(nrow(csv)), function(i){
p <- fromJSON(csv$site_positions[i]); s <- fromJSON(csv$site_supports[i])
js <- unlist(sbps[as.character(p)], use.names = FALSE)
##supports 1e-6 to 1e-149 , rel tol
all(abs(js - s) <= 1e-9 * abs(js))
},
logical(1))
)
m_seq <- all(vapply(csv$sequence_names,
function(s) setequal(fromJSON(s), tips),
logical(1))
)
####row-1 vals for display only
d_bps <- as.numeric(unlist(fromJSON(csv$partition_bps[1], simplifyVector = FALSE)))
d_ibp <- as.numeric(unlist(fromJSON(csv$improvements_breakpoints[1], simplifyVector = FALSE)))
d_dA <- fromJSON(csv$improvements_deltaAICc[1])
d_sp <- as.integer(fromJSON(csv$site_positions[1])); d_ss <- fromJSON(csv$site_supports[1]); d_seq <- fromJSON(csv$sequence_names[1])
##one json/csv/match row per gard-eh col (16)
cols <- c(names(jnum),
"gene", "file_name", "partition_bps", "improvements_breakpoints",
"improvements_deltaAICc", "site_positions", "site_supports", "sequence_names",
"partition", "partition_nt_range")
json_v <- c(as.character(jnum),
gene_exp, file_exp, toString(bps), toString(ibp), toString(dA),
sprintf("%d sites [%d-%d]", length(sbps), min(jp), max(jp)),
sprintf("%d supports", length(sbps)), sprintf("%d taxa", length(tips)),
toString(as.integer(parts)), toString(json_rng))
csv_v <- c(as.character(unlist(csv[1, names(jnum)])),
csv$gene[1], csv$file_name[1], toString(d_bps), toString(d_ibp), toString(d_dA),
sprintf("%d sites [%d-%d]", length(d_sp), min(d_sp), max(d_sp)),
sprintf("%d supports", length(d_ss)), sprintf("%d taxa", length(d_seq)),
toString(csv$partition[ord]), toString(csv$partition_nt_range[ord]))
match_v<- c(m_num,
all(csv$gene == gene_exp),
all(csv$file_name == file_exp),
m_bps, m_ibp, m_dA, m_spos, m_ssup, m_seq,
setequal(csv$partition, as.integer(parts)) && length(csv$partition) == length(parts),
all(csv$partition_nt_range[ord] == json_rng))
print(data.frame(column = cols, json = json_v, csv = csv_v, match = match_v),
row.names = FALSE)
##clear on 16 gardeh cols
# J   <- fromJSON("FMO1_MEME.json", simplifyVector = FALSE)
# jf <- "FMO1_MEME.json"
# csv <- read.csv("fmo1_memeEH.csv", stringsAsFactors = FALSE)
J   <- fromJSON("TSPO_MEME.json", simplifyVector = FALSE)
jf <- "TSPO_MEME.json"
csv <- read.csv("tspo_memeEH.csv", stringsAsFactors = FALSE)
tol <- 1e-8
n <- nrow(csv)
## header-anchored column resolution (normalize &alpha;/&beta;/markup, then match by name)
norm <- function(s) tolower(trimws(gsub("<[^>]*>","", gsub("&beta;","b", gsub("&alpha;","a", s)))))
hn <- vapply(J$MLE$headers, function(h) norm(h[[1]]), character(1))
ia<-match("a",hn)
ibp<-match("b+",hn)
il<-match("lrt",hn)
ip<-match("p-value",hn)
im<-match("meme logl",hn)
gene_exp <- sub("_.*","", basename(J[["input"]][["file name"]]))
file_exp <- basename(jf)
rng <- function(p){ cov<-as.integer(unlist(J[["data partitions"]][[p]]$coverage)); sprintf("%d-%d",min(cov),max(cov)) }
gv  <- function(rec,k) if (is.null(rec)) NULL else rec[[k]]
## per (partition,branch): surviving sites (0-based) = p<=0.05 AND a real substitution on that branch
surv <- function(p,b){ cont<-J$MLE$content[[p]]; subs<-J$substitutions[[p]]; keep<-integer(0)
for (i in 0:(length(cont)-1)){ if (as.numeric(cont[[i+1]][[ip]])>0.05) next
sv<-subs[[as.character(i)]]; if (!is.null(sv)&&!is.null(sv[[b]])&&sv[[b]]!="---") keep<-c(keep,i) }; keep }
rcol <- function(p,s,idx) if (length(s)) vapply(s,function(i) as.numeric(J$MLE$content[[p]][[i+1]][[idx]]),numeric(1)) else numeric(0)
subbr<- function(p){ o<-character(0); for (sv in J$substitutions[[p]]) if (!is.null(sv)) for (br in names(sv)) if (!is.null(sv[[br]])&&sv[[br]]!="---") o<-c(o,br); unique(o) }
## precompute every row's JSON-side reference once
RR <- lapply(seq_len(n), function(i){
p <-as.character(csv$partition[i])
b <-csv$branch[i]
s <-surv(p,b)
rec <-J[["branch attributes"]][[p]][[b]]
list(p=p,b=b, pos=s+1, pv=rcol(p,s,ip), lr=rcol(p,s,il), al=rcol(p,s,ia), be=rcol(p,s,ibp), lg=rcol(p,s,im),
sb=if(length(s)) vapply(s,function(i)
J$substitutions[[p]][[as.character(i)]][[b]],character(1)) else character(0),
gmg=gv(rec,"Global MG94xREV"), ng=gv(rec,"Nucleotide GTR"), on=gv(rec,"original name"))
})
## comparators, parsers, bag-summariser (json & csv summarised identically)
neq <- function(a,b) length(a)==length(b) && all(abs(a-b) <= tol*pmax(1,abs(b)))
aok <- function(cv,ref){ if (is.null(ref)) return(is.na(cv)||cv=="")                      # R reads blank char as ""; treat as null
if (is.numeric(ref)) return(!is.na(cv) && abs(as.numeric(cv)-ref)<=tol*max(1,abs(ref))); as.character(cv)==as.character(ref) }
pc  <- function(x,k) if (k=="str") strsplit(gsub("[][' ]","",x),",")[[1]] else if (k=="int") as.integer(fromJSON(x)) else as.numeric(fromJSON(x))
bs  <- function(v,k){ v<-v[!is.na(v)]; if(!length(v)) return("n0")
if(k=="str"){ u<-sort(unique(v)); if(length(u)>4) u<-c(u[1:4],"..."); return(sprintf("n%d{%s}",length(v),paste(substr(u,1,16),collapse=","))) }
if(k=="int") return(sprintf("n%d[%d-%d]",length(v),min(v),max(v)))
sprintf("n%d[%s..%s]",length(v),formatC(min(v),format="g",digits=3),formatC(max(v),format="g",digits=3)) }
## row builders -> column | json | csv | match, each checked over ALL rows
r_const<- function(col,val) data.frame(column=col, json=as.character(val), csv=as.character(csv[[col]][1]), match=all(csv[[col]]==val))
r_list <- function(col,key,kind){ cv<-lapply(seq_len(n),function(i) pc(csv[[col]][i],kind)); rf<-lapply(RR,`[[`,key)
eq<-if(kind=="str") function(a,b) identical(a,b) else if(kind=="int") function(a,b) identical(as.integer(a),as.integer(b)) else neq
data.frame(column=col, json=bs(unlist(rf),kind), csv=bs(unlist(cv),kind), match=all(vapply(seq_len(n),function(i) eq(cv[[i]],rf[[i]]),logical(1)))) }
r_srow <- function(col,key,kind){ rf<-lapply(RR,function(r){x<-r[[key]]; if(is.null(x)) NA else x})
cb<-csv[[col]]; if(kind=="str") cb[cb==""]<-NA
data.frame(column=col, json=bs(unlist(rf),kind), csv=bs(cb,kind), match=all(vapply(seq_len(n),function(i) aok(csv[[col]][i],RR[[i]][[key]]),logical(1)))) }
print(rbind(
r_const("gene", gene_exp), r_const("json_file", file_exp),
data.frame(column="partition", json=paste(sort(as.integer(names(J$MLE$content))),collapse=","),
csv=paste(sort(unique(csv$partition)),collapse=","), match=all(csv$partition %in% as.integer(names(J$MLE$content)))),
data.frame(column="partition_codon_range", json=paste(sort(unique(vapply(RR,function(r) rng(r$p),""))),collapse=","),
csv=paste(sort(unique(csv$partition_codon_range)),collapse=","), match=all(vapply(seq_len(n),function(i) csv$partition_codon_range[i]==rng(RR[[i]]$p),logical(1)))),
data.frame(column="branch", json=sprintf("%d valid",n), csv=sprintf("%d branches",length(unique(csv$branch))),
match=all(vapply(seq_len(n),function(i) RR[[i]]$b %in% names(J[["branch attributes"]][[RR[[i]]$p]]) || RR[[i]]$b %in% subbr(RR[[i]]$p),logical(1)))),
r_srow("Global_MG94xREV","gmg","num"), r_srow("Nucleotide_GTR","ng","num"), r_srow("original_name","on","str"),
r_list("site_positions","pos","int"), r_list("site_pval","pv","num"), r_list("site_LRT","lr","num"),
r_list("site_alpha","al","num"), r_list("site_beta_plus","be","num"), r_list("site_MEMElogl","lg","num"),
r_list("site_substitution","sb","str")
), row.names = FALSE)
### no pos sites in part0 so part1 is TRUE in partition col; only pos is codon 369
View(csv)
# J   <- fromJSON("FMO1_FUBAR.json", simplifyVector = FALSE)
# jf <- "FMO1_FUBAR.json"
# csv <- read.csv("fmo1_fubarEH.csv", stringsAsFactors = FALSE, check.names = FALSE)
J   <- fromJSON("TSPO_FUBAR.json", simplifyVector = FALSE)
jf <- "TSPO_FUBAR.json"
csv <- read.csv("tspo_fubarEH.csv", stringsAsFactors = FALSE, check.names = FALSE)
tol <- 1e-8
n <- nrow(csv)
## header-anchored resolution (would catch a FEL-style drift in the harvester's hardcoded [0-5])
hdr <- vapply(J$MLE$headers, function(h) h[[1]], character(1))
ia<-match("alpha",hdr); ib<-match("beta",hdr); iba<-match("beta-alpha",hdr)
ipg<-match("Prob[alpha>beta]",hdr); ipl<-match("Prob[alpha<beta]",hdr); ibf<-match("BayesFactor[alpha<beta]",hdr)
gene_exp <- sub("_.*","", basename(J[["input"]][["file name"]]))                          # JSON's own input slot
info <- J$analysis$info; prog_exp <- gsub("[()]","", regmatches(info, regexpr("\\([A-Za-z-]+\\)", info)))  # acronym from analysis.info
parts <- names(J$MLE$content); ba <- J[["branch attributes"]]
rng <- function(p){ cov<-as.integer(unlist(J[["data partitions"]][[p]]$coverage)); sprintf("%d-%d",min(cov),max(cov)) }
## per-partition FUBAR harvest (site-level, identical across branches): sig site = P[a>b]>=0.9 OR P[a<b]>=0.9
sig  <- function(p){ M<-J$MLE$content[[p]]; keep<-integer(0)
for (i in 0:(length(M)-1)){ r<-M[[i+1]]; pg<-r[[ipg]]; pl<-r[[ipl]]; if ((is.numeric(pg)&&pg>=0.9)||(is.numeric(pl)&&pl>=0.9)) keep<-c(keep,i) }; keep }
hcol <- function(p,s,idx) if(length(s)) vapply(s,function(i) as.numeric(J$MLE$content[[p]][[i+1]][[idx]]),numeric(1)) else numeric(0)
H <- lapply(parts, function(p){ s<-sig(p); list(sites=s+1, al=hcol(p,s,ia), be=hcol(p,s,ib), ba=hcol(p,s,iba),
pg=hcol(p,s,ipg), pl=hcol(p,s,ipl), bf=hcol(p,s,ibf)) }); names(H)<-parts
neq <- function(a,b) length(a)==length(b) && all(abs(a-b) <= tol*pmax(1,abs(b)))
pof <- function(i) as.character(csv$partition[i])
pc  <- function(x,k) if(k=="int") as.integer(fromJSON(x)) else as.numeric(fromJSON(x))
bg  <- function(v,k){ v<-v[!is.na(v)]; if(!length(v)) return("n0")
if(k=="int") sprintf("n%d[%d-%d]",length(v),min(v),max(v)) else sprintf("n%d[%s..%s]",length(v),formatC(min(v),format="g",digits=3),formatC(max(v),format="g",digits=3)) }
## builders -> column | json | csv | match, each checked over ALL rows
r_const<- function(col,val) data.frame(column=col, json=as.character(val), csv=as.character(csv[[col]][1]), match=all(csv[[col]]==val))
r_pc   <- function(col,key,kind){ eq<-if(kind=="int") function(a,b) identical(as.integer(a),as.integer(b)) else neq   # per-partition site column
cellp<-function(p) pc(csv[[col]][csv$partition==as.integer(p)][1],kind)
data.frame(column=col, json=paste(vapply(parts,function(p) bg(H[[p]][[key]],kind),""),collapse=", "),
csv=paste(vapply(parts,function(p) bg(cellp(p),kind),""),collapse=", "),
match=all(vapply(seq_len(n),function(i) eq(pc(csv[[col]][i],kind),H[[pof(i)]][[key]]),logical(1)))) }
branch_ok <- vapply(seq_len(n),function(i){ p<-pof(i); b<-csv$branch[i]
b %in% names(ba[[p]]) && b==(if(!is.null(ba[[p]][[b]][["original name"]])) ba[[p]][[b]][["original name"]] else b) },logical(1))
gtrref <- vapply(seq_len(n),function(i){ g<-ba[[pof(i)]][[csv$branch[i]]][["Nucleotide GTR"]]; if(is.null(g)) NA_real_ else g },numeric(1))
print(rbind(
r_const("gene", gene_exp), r_const("program", prog_exp),
data.frame(column="partition", json=paste(sort(as.integer(parts)),collapse=","), csv=paste(sort(unique(csv$partition)),collapse=","), match=all(csv$partition %in% as.integer(parts))),
data.frame(column="partition_codon_range", json=paste(vapply(parts,rng,""),collapse=", "), csv=paste(sort(unique(csv$partition_codon_range)),collapse=", "), match=all(vapply(seq_len(n),function(i) csv$partition_codon_range[i]==rng(pof(i)),logical(1)))),
data.frame(column="branch", json=sprintf("%d rows",n), csv=sprintf("%d valid/%d uniq",sum(branch_ok),length(unique(csv$branch))), match=all(branch_ok)),
data.frame(column="GTR", json=bg(gtrref,"num"), csv=bg(csv$GTR,"num"), match=all(vapply(seq_len(n),function(i){g<-ba[[pof(i)]][[csv$branch[i]]][["Nucleotide GTR"]]; !is.null(g)&&abs(as.numeric(csv$GTR[i])-g)<=tol*max(1,abs(g))},logical(1)))),
r_pc("sites","sites","int"), r_pc("alpha","al","num"), r_pc("beta","be","num"), r_pc("beta-alpha","ba","num"),
r_pc("Prob[alpha>beta]","pg","num"), r_pc("Prob[alpha<beta]","pl","num"), r_pc("BayesFactor[alpha<beta]","bf","num")
), row.names = FALSE)
# J   <- fromJSON("FMO1part1_aBSREL.json", simplifyVector = FALSE)
# csv <- read.csv("fmo1_absrelp1EH.csv", stringsAsFactors = FALSE)
J   <- fromJSON("TSPOpart1_aBSREL.json", simplifyVector = FALSE)
csv <- read.csv("tspopart1_absrelEH.csv", stringsAsFactors = FALSE)
tol <- 1e-8
n <- nrow(csv)
gene_exp <- sub("_aBSREL\\.json$","", basename("FMO1part1_aBSREL.json"))                 # filename carve-out (no clean JSON-body source)
prog_exp <- sub("\\s.*","", J$analysis$info)                        # first token of analysis.info -> "aBSREL"
ba <- J[["branch attributes"]][["0"]]                               # single partition key within this split file
species <- function(bid){ p<-strsplit(bid,"_")[[1]]; if (length(p)>1) p[2] else "NA" }
maxo <- function(bs){ rd<-bs[["Rate Distributions"]]; if(!length(rd)) return(NA_real_); max(vapply(rd,function(x) as.numeric(x[[1]]),numeric(1))) }
## branches that SHOULD be kept: has LRT, p<=0.05, max omega class > 1 (episodic diversifying selection)
kept <- Filter(function(bid){ bs<-ba[[bid]]; pc<-bs[["Corrected P-value"]]; pu<-bs[["Uncorrected P-value"]]; pv<-if(!is.null(pc)) pc else pu; mo<-maxo(bs)
!is.null(bs[["LRT"]]) && !is.null(pv) && pv<=0.05 && !is.na(mo) && mo>1 }, names(ba))
## per selected-branch references
RR <- lapply(seq_len(n), function(i){ bid<-csv$branch_id[i]; bs<-ba[[bid]]
rd<-bs[["Rate Distributions"]]; oms<-vapply(rd,function(x) as.numeric(x[[1]]),numeric(1)); wts<-vapply(rd,function(x) as.numeric(x[[2]]),numeric(1))
dN<-bs[["Full adaptive model (non-synonymous subs/site)"]]; dS<-bs[["Full adaptive model (synonymous subs/site)"]]; pc<-bs[["Corrected P-value"]]; pu<-bs[["Uncorrected P-value"]]
list(bid=bid, LRT=bs[["LRT"]], pv=if(!is.null(pc)) pc else pu, pc=pc, pu=pu, dN=dN, dS=dS,
bo=if(!is.null(dN)&&!is.null(dS)&&dS!=0) dN/dS else NULL, bom=bs[["Baseline MG94xREV omega ratio"]],
blnl=bs[["Baseline MG94xREV"]], gtr=bs[["Nucleotide GTR"]], rc=bs[["Rate classes"]],
oms=oms, wts=wts, po=oms[oms>1], pw=wts[oms>1], mo=if(length(oms)) max(oms) else NA_real_) })
neq <- function(a,b) length(a)==length(b) && all(abs(a-b) <= tol*pmax(1,abs(b)))
sc  <- function(cv,ref){ if(is.null(ref)) return(is.na(cv)||cv==""); !is.na(cv) && abs(as.numeric(cv)-as.numeric(ref))<=tol*max(1,abs(as.numeric(ref))) }
pl  <- function(x){ v<-fromJSON(x); if(length(v)==0) numeric(0) else as.numeric(v) }
bg  <- function(v,k){ v<-v[!is.na(v)]; if(!length(v)) return("n0"); if(k=="str") return(paste(sort(unique(v)),collapse=",")); sprintf("n%d[%s..%s]",length(v),formatC(min(v),format="g",digits=3),formatC(max(v),format="g",digits=3)) }
## builders -> column | json | csv | match, each checked over ALL rows
r_const<- function(col,val) data.frame(column=col, json=as.character(val), csv=as.character(csv[[col]][1]), match=all(csv[[col]]==val))
r_sb   <- function(col,key){ bag<-vapply(RR,function(r){x<-r[[key]]; if(is.null(x)) NA_real_ else as.numeric(x)},numeric(1))       # per-branch scalar
data.frame(column=col, json=bg(bag,"num"), csv=bg(csv[[col]],"num"), match=all(vapply(seq_len(n),function(i) sc(csv[[col]][i],RR[[i]][[key]]),logical(1)))) }
r_lb   <- function(col,key) data.frame(column=col, json=bg(unlist(lapply(RR,`[[`,key)),"num"),                                     # per-branch rate-class list
csv=bg(unlist(lapply(seq_len(n),function(i) pl(csv[[col]][i]))),"num"),
match=all(vapply(seq_len(n),function(i) neq(pl(csv[[col]][i]),RR[[i]][[key]]),logical(1))))
print(rbind(
r_const("gene_id", gene_exp), r_const("program", prog_exp),
data.frame(column="branch_id", json=sprintf("%d selected",length(kept)), csv=sprintf("%d rows",n), match=setequal(csv$branch_id, kept)),
data.frame(column="species", json=bg(vapply(RR,function(r) species(r$bid),""),"str"),
csv=paste(sort(unique(ifelse(is.na(csv$species),"NA",csv$species))),collapse=","),
match=all(vapply(seq_len(n),function(i){ e<-species(csv$branch_id[i]); if(e=="NA") is.na(csv$species[i])||csv$species[i]=="NA" else !is.na(csv$species[i])&&csv$species[i]==e },logical(1)))),
r_sb("aBSREL_LRT","LRT"), r_sb("aBSREL_pvalue","pv"), r_sb("aBSREL_pvalue_corrected","pc"), r_sb("aBSREL_pvalue_uncorrected","pu"),
r_sb("aBSREL_branch_dN","dN"), r_sb("aBSREL_branch_dS","dS"), r_sb("aBSREL_branch_omega","bo"),
r_sb("aBSREL_baseline_omega","bom"), r_sb("aBSREL_baseline_lnL","blnl"), r_sb("aBSREL_nucleotide_GTR","gtr"),
r_sb("aBSREL_rate_classes","rc"), r_lb("aBSREL_omega_classes","oms"), r_lb("aBSREL_omega_weights","wts"),
r_lb("aBSREL_positive_omega_classes","po"), r_lb("aBSREL_positive_omega_weights","pw"), r_sb("aBSREL_max_omega","mo")
), row.names = FALSE)
